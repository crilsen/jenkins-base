# Real config with the admin password and the role ARN
casc/jenkins.yaml

# Terraform working dir created by examples/Jenkinsfile.terraform when run locally
examples/terraform/.terraform/
examples/terraform/.terraform.lock.hcl

# State snapshots made by scripts/backup.sh (bind-mounted state, not a volume)
backups/

# Runtime state (bind mount, includes the agent secret) and local env
data/
.env
